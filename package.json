{
  "name": "dsh-better-model-thinking-control",
  "version": "0.1.7",
  "description": "DSH 中转站模型思考强度配置与自动识别插件",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "reasoning",
    "thinking",
    "openai-compatible"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guyao146/dsh-better-model-thinking-control.git"
  },
  "bugs": {
    "url": "https://github.com/Guyao146/dsh-better-model-thinking-control/issues"
  },
  "homepage": "https://github.com/Guyao146/dsh-better-model-thinking-control#readme",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime"]
    }
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT"
}